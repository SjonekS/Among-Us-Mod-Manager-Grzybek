<Window x:Class="AmongUsModManager.ModBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AmongUsModManager.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:ModBrowserViewModel}"
        mc:Ignorable="d"
        Title="Among Us Mod Browser (Katalog Modów v3.0)" 
        Height="780" Width="1180"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" 
        Foreground="#E2E8F0"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Lewy Boczny Tray (Zwijany / Rozwijany) -->
            <ColumnDefinition Width="Auto" />
            <!-- Główna zawartość katalogu -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEWY BOCZNY TRAY (SELEKTOR INSTANCJI + PRZYCISKI FUNKCYJNE) -->
        <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0" Padding="14">
            <Grid Width="240">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Nagłówek Trayu -->
                <TextBlock Grid.Row="0" Text="Środowisko Docelowe" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />

                <!-- Selektor Instancji -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="Zarządzana instancja / gra:" FontSize="11" Foreground="{DynamicResource SubTextColor}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding AvailableTargets}" 
                              SelectedItem="{Binding SelectedTarget}" 
                              DisplayMemberPath="Name" 
                              Style="{StaticResource DarkComboBoxStyle}" 
                              Margin="0,0,0,10" />

                    <!-- Przyciski funkcyjne (Ikonkowe z etykietami) -->
                    <StackPanel Orientation="Vertical">
                        <Button Content="📂 Otwórz folder gry" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenGameFolderCommand}" Margin="0,0,0,6" ToolTip="Otwórz folder wybranej instalacji w Eksploratorze Windows" HorizontalContentAlignment="Left" Padding="10,6" />
                        <Button Content="🔄 Odśwież stan modów" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshModsStatusCommand}" Margin="0,0,0,6" ToolTip="Sprawdź stan plików w folderze wybranej instancji" HorizontalContentAlignment="Left" Padding="10,6" />
                    </StackPanel>
                </StackPanel>

                <!-- Informacja o środowisku -->
                <Border Grid.Row="2" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Wybrana ścieżka:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SubTextColor}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding SelectedTarget.Path}" FontSize="11" Foreground="#FFFFFF" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Stopka Trayu -->
                <TextBlock Grid.Row="3" Text="Mod Browser v3.0 (Preview)" FontSize="10" Foreground="{DynamicResource SubTextColor}" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </Grid>
        </Border>

        <!-- PRAWA STRONA: GŁÓWNY KATALOG MODÓW -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Pasek górny: Wyszukiwarka + Filtry -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Pole wyszukiwania -->
                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,12,0">
                    <Grid>
                        <TextBlock Text="🔍 Szukaj modyfikacji (nazwa, autor, opis)..." FontSize="12" Foreground="{DynamicResource SubTextColor}" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Przyciski filtrów -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Wszystkie" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Command="{Binding SetFilterCommand}" CommandParameter="All" Padding="12,6" />
                    <Button Content="Zainstalowane" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Command="{Binding SetFilterCommand}" CommandParameter="Installed" Padding="12,6" />
                    <Button Content="Dostępne" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="NotInstalled" Padding="12,6" />
                </StackPanel>
            </Grid>

            <!-- Główna zawartość: Lista modów (po lewej) + Szczegóły (po prawej) -->
            <!-- Główna zawartość: Siatka Kart Modów w stylu Starlight / CurseForge -->
            <Grid Grid.Row="1">
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FilteredMods}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Karta Modyfikacji w stylu Starlight Launcher -->
                                    <Border Width="340" MinHeight="175" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="6" Padding="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#131B27" Offset="0.0" />
                                                <GradientStop Color="#090E17" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#1E293B" Offset="0.0" />
                                                                    <GradientStop Color="#101726" Offset="1.0" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Górna linia: Ikona, Tytuł, autor i plakietka statusu -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Ikona moda / Avatar projektu -->
                                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="{DynamicResource CardBorder}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Grid>
                                                        <!-- Placeholder gdy obrazek się ładuje / brak -->
                                                        <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Border CornerRadius="8">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding DisplayIcon}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <Border Background="{DynamicResource HeaderBadgeBg}" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource HeaderBadgeFg}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Author, StringFormat='by {0}'}" FontSize="11" Foreground="{DynamicResource SubTextColor}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Plakietka statusu -->
                                                <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" Margin="4,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1E293B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                                    <Setter Property="Background" Value="#143A2A" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="MissingCoreDependency">
                                                                    <Setter Property="Background" Value="#452B14" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Dostępny" />
                                                                <Setter Property="Foreground" Value="#94A3B8" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                                        <Setter Property="Text" Value="Zainstalowany" />
                                                                        <Setter Property="Foreground" Value="#34D399" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="MissingCoreDependency">
                                                                        <Setter Property="Text" Value="Wymaga TouMira" />
                                                                        <Setter Property="Foreground" Value="#FBBF24" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>

                                            <!-- Środek: Opis moda -->
                                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource SubTextColor}" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" LineHeight="16" Margin="0,0,0,10" />

                                            <!-- Dolna belka: Przyciski Szczegóły oraz Instaluj/Odinstaluj -->
                                            <Grid Grid.Row="2" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Przycisk Szczegóły -->
                                                <Button Grid.Column="0" Content="ℹ Szczegóły" Style="{StaticResource SecondaryButtonStyle}" 
                                                        Command="{Binding DataContext.SelectModCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Left" Padding="12,5" FontSize="11" ToolTip="Otwórz pełny opis, źródło i informacje o pakiecie" />

                                                <!-- Przyciski Akcji: Instaluj / Odinstaluj w zależności od statusu -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <!-- Przycisk Odinstaluj (widoczny gdy zainstalowany i nie Core) -->
                                                    <Button Content="🗑" Margin="0,0,4,0" Padding="8,5" FontSize="11"
                                                            Command="{Binding DataContext.UninstallModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Foreground="#FCA5A5" Background="#3A1C1C" ToolTip="Odinstaluj ten mod">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- Przycisk Zainstaluj / Aktualizuj -->
                                                    <Button Padding="14,5" FontSize="11"
                                                            Command="{Binding DataContext.InstallModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                                <Setter Property="Content" Value="⬇ Pobierz" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                                        <Setter Property="Content" Value="✓ Gotowy" />
                                                                        <Setter Property="Background" Value="#1E3B2F" />
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="MissingCoreDependency">
                                                                        <Setter Property="Content" Value="Brak TouMira" />
                                                                        <Setter Property="Background" Value="#3D3019" />
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- NAKŁADKA MODALNA: PEŁNY OPIS MODA (STYLE STARLIGHT / CURSEFORGE) -->
                <Border Background="#D9000000" CornerRadius="8" Padding="24"
                        Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVis}}"
                        Panel.ZIndex="100">
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="24" MaxWidth="680" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Nagłówek okna szczegółów z przyciskiem X -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Duża Ikona Moda -->
                                <Border Grid.Column="0" Width="54" Height="54" CornerRadius="10" Background="{DynamicResource CardBorder}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="📦" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border CornerRadius="10">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding SelectedMod.DisplayIcon}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedMod.Name}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Background="{DynamicResource HeaderBadgeBg}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedMod.Category, StringFormat='Kategoria: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource HeaderBadgeFg}" />
                                        </Border>
                                        <TextBlock Text="{Binding SelectedMod.Author, StringFormat='Autor: {0}'}" FontSize="12" Foreground="{DynamicResource SubTextColor}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource CloseIconButtonStyle}" Command="{Binding CloseDetailsCommand}" ToolTip="Zamknij podgląd" VerticalAlignment="Top" />
                            </Grid>

                            <!-- Środek: Przewijalny pełny opis i detale techniczne -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="O modyfikacji:" FontSize="13" FontWeight="Bold" Foreground="#E0E0E6" Margin="0,0,0,6" />
                                    <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                        <TextBlock Text="{Binding SelectedMod.Description}" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="20" />
                                    </Border>

                                    <!-- Sekcja repozytorium GitHub i techniczna -->
                                    <TextBlock Text="Informacje techniczne i repozytorium:" FontSize="13" FontWeight="Bold" Foreground="#E0E0E6" Margin="0,0,0,6" />
                                    <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedMod.RepoOwner, StringFormat='Repozytorium GitHub: {0}/'}" FontSize="12" Foreground="{DynamicResource SubTextColor}">
                                                <Run Text="{Binding SelectedMod.RepoName}" Foreground="#FFFFFF" FontWeight="Bold" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding SelectedMod.TargetPluginFileName, StringFormat='Plik wtyczki BepInEx: {0}'}" FontSize="11" Foreground="{DynamicResource SubTextColor}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding SelectedMod.InstalledVersion, StringFormat='Aktualnie zainstalowana wersja: {0}', FallbackValue='Aktualnie zainstalowana wersja: Brak'}" FontSize="11" Foreground="{DynamicResource SubTextColor}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Button Content="🌐 Otwórz stronę projektu na GitHub" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenProjectPageCommand}" HorizontalAlignment="Left" Padding="14,6" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Stopka modala: Przyciski akcji (Pobierz / Odinstaluj / Zamknij) -->
                            <Border Grid.Row="2" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Przycisk Odinstaluj -->
                                    <Button Grid.Column="0" Content="🗑 Odinstaluj modyfikację"
                                            Command="{Binding UninstallModCommand}" CommandParameter="{Binding SelectedMod}"
                                            Foreground="#FCA5A5" Background="#3A1C1C" Padding="14,8"
                                            IsEnabled="{Binding IsNotBusy}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedMod.Status}" Value="Installed">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Przycisk Zamknij i Pobierz/Zainstaluj po prawej -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="Zamknij" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CloseDetailsCommand}" Margin="0,0,8,0" Padding="14,8" />
                                        <Button Content="⬇ Pobierz i zainstaluj" Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding InstallModCommand}" CommandParameter="{Binding SelectedMod}"
                                                IsEnabled="{Binding IsNotBusy}" Padding="18,8" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Border>
            </Grid>

            <!-- Pasek statusu i postępu (Dół) -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource SubTextColor}" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Height="6" Width="140" Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" IsIndeterminate="{Binding IsBusy}" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
